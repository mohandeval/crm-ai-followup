# ─────────────────────────────────────────────────────────────
# AI CRM Follow-Up — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL (provided by DEA) ─────────────────────────
POSTGRES_HOST=dea.cgyi97rb4alr.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=dea_analytics_dev
POSTGRES_USER=student_user
POSTGRES_PASSWORD=DataEngineer12345
POSTGRES_SCHEMA=sales_raw

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Pinecone Serverless ──────────────────────────────────────
# Get free API key at: https://www.pinecone.io/
PINECONE_API_KEY=pcsk_...your-key-here...
PINECONE_ENVIRONMENT=us-east-1          # AWS region for serverless
PINECONE_INDEX_NURTURE=crm-nurture-content
PINECONE_INDEX_TESTIMONIALS=crm-testimonials
PINECONE_EMBED_DIMENSION=1536           # matches text-embedding-3-small

# ── LangSmith (optional but recommended for observability) ───
# Get key at: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...your-key-here...
LANGCHAIN_PROJECT=crm-ai-followup

# ── App Settings ─────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_ACTIVITIES_PER_LEAD=50
EMAIL_COOLDOWN_HOURS=48
TOP_K_RETRIEVAL=10
